# Unity-generated folders (regenerated on Unity open)
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
*.log
.utmp/

# IDE / project files (regenerated)
*.csproj
*.sln
*.suo
*.user
*.userprefs
.vs/
.idea/
*.DotSettings.user

# Blender backup files
*.blend1
*.blend1.meta

# Build artefactos en root (legacy — del repo cuando solo hosted builds)
# StreamingAssets/ — comentado, ya no aplica (no usamos PAD aquí)
# StreamingAssets/

# WebGL deploy output (sube a R2, no a git)
/webgl-output/
/webgl-output-empty/
/webgl-build/

# Addressables build output — bundles generados por Build Player Content (389MB+)
# Se deployan a R2 vía aws s3 sync, no se versionan
/ServerData/

# Claude Code internal files
.claude/scheduled_tasks.lock

# Pack 24 third-party — pesos grandes a NO commitear
# Aclaración: en el TV project SÍ necesitamos los modelos para que la escena
# los referencie. Si son >100MB cada uno hay que usar Git LFS o hostear aparte.
# Por ahora copiamos los .fbx + textures small enough.
# (Si algún archivo supera 100MB en commit, GitHub lo bloqueará → revisar entonces)

# AppquariumEditor cache temporal (no aplica aquí pero por costumbre del mobile)
/_WebGLBuildTemp/

# Node — suite de test local (puppeteer). package.json sí se versiona.
/node_modules/
/package-lock.json

# Salidas de test local / scratch en root (no son assets)
/deco-clean.png
/deco-floor.png
/fps-check.png
/local-test-screenshot.png
/local-test-zoom.png
/local-test-anchor-zoom.png
/catalog_1.2.1.hash

# OS-specific
.DS_Store
Thumbs.db

# Large audio binaries — stored locally only (Addressables, not needed in repo)
Assets/Resources/Audio/*.wav
Assets/Resources/Audio/*.mp3
Assets/Resources/Audio/*.ogg
/scratchpad/
