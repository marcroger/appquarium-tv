// PLANTILLA. Copiar a Assets/Scripts/Core/TvBundleAuthSecret.cs y poner el token real.
//
// Ese destino está en .gitignore a propósito: el repo es PÚBLICO y el token es lo único
// que separa los 87 MB de bundles de cualquiera con la URL del Worker. Ver el README.
//
// Sin este fichero el proyecto compila igual, pero TvBundleAuthPreflight ABORTA cualquier
// build de WebGL: un player sin token no da error, simplemente se queda sin bundles.
//
// El valor tiene que coincidir con uno de los del secret BUNDLE_TOKENS del Worker
// (acepta varios separados por coma, justamente para poder rotar sin cortar el servicio).
public static partial class TvBundleAuth
{
    static partial void SupplyFallbackToken(ref string token)
    {
        token = "aqtv_PON_AQUI_EL_TOKEN_REAL";
    }
}
